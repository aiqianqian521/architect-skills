{
  "dimension": "git",
  "checklist": [
    {
      "id": "GIT-01",
      "rule": "提交消息是否遵循 Conventional Commits 格式？",
      "trigger": "不符合: 用 <type>(<scope>): <subject> 重写",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·1"
    },
    {
      "id": "GIT-02",
      "rule": "一次提交是否只做一件事（feat和fix分开）？",
      "trigger": "混在一起: git reset HEAD~1 → 拆分为多个原子提交",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·2"
    },
    {
      "id": "GIT-03",
      "rule": "是否使用了合适的分支策略？",
      "trigger": "不合适: 小团队用 Trunk-Based，有 PR 审查用 GitHub Flow",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·3"
    },
    {
      "id": "GIT-04",
      "rule": "合并冲突是否基于意图（而非行选择）解决？",
      "trigger": "基于行选: 先读 git log 了解双方意图，再综合写合并结果",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·4"
    },
    {
      "id": "GIT-05",
      "rule": "合并后测试是否通过？",
      "trigger": "未验证: 跑完整测试套件 + lint 检查",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·5"
    },
    {
      "id": "GIT-06",
      "rule": ".gitignore 是否排除了数据库文件、__pycache__、.venv？",
      "trigger": "缺失: 添加 *.db、__pycache__/、.venv/、*.pyc",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·6"
    }
  ],
  "output_schema": {
    "required": [
      "id",
      "type",
      "evidence",
      "risk_level",
      "confidence",
      "next_step"
    ],
    "fields": {
      "id": {
        "type": "string",
        "pattern": "^GIT-[0-9]{2}$",
        "description": "必须引用 checklist 中的规则 ID"
      },
      "type": {
        "type": "string",
        "enum": [
          "pattern_violation",
          "missing_mechanism",
          "design_flaw",
          "performance_issue",
          "other",
          "unknown"
        ],
        "description": "发现类型"
      },
      "evidence": {
        "type": "string",
        "min_length": 10,
        "description": "行级证据：文件路径 + 行号 + 代码片段"
      },
      "risk_level": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "按 risk-grading-scheme.md 量化口径判定"
      },
      "risk_scheme_ref": {
        "type": "string",
        "description": "引用 risk-grading-scheme.md 触发条件编号"
      },
      "confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "对定级和证据的置信度"
      },
      "next_step": {
        "type": "string",
        "min_length": 10,
        "description": "具体可执行的下一步，含验证命令或人工复核说明"
      },
      "verify_command": {
        "type": "string",
        "description": "可运行的验证命令（GREEN-first）"
      },
      "rollback": {
        "type": "string",
        "description": "失败时的撤退路径"
      }
    }
  },
  "meta": {
    "version": "1.0",
    "updated_at": "2026-09-14",
    "source_skill": "architect-git",
    "scene": "B",
    "note": "本契约仅用于蜂群模式（场景 B）的方案评审。"
  }
}