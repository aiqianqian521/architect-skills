{
  "dimension": "design",
  "checklist": [
    {
      "id": "DES-01",
      "rule": "概念",
      "trigger": "定义 | loop 项目示例",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·1"
    },
    {
      "id": "DES-02",
      "rule": "------",
      "trigger": "------|-------------",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·2"
    },
    {
      "id": "DES-03",
      "rule": "实体",
      "trigger": "有唯一标识 | Task, Round, Pattern",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·3"
    },
    {
      "id": "DES-04",
      "rule": "值对象",
      "trigger": "无标识，不可变 | TaskInput, TaskResult, RoundContext",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·4"
    },
    {
      "id": "DES-05",
      "rule": "聚合根",
      "trigger": "一组相关对象的入口 | Orchestrator → Round → OODA Steps",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·5"
    },
    {
      "id": "DES-06",
      "rule": "限界上下文",
      "trigger": "不同子域用不同术语 | 回测域 Signal ≠ 文档域 Event",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·6"
    },
    {
      "id": "DES-07",
      "rule": "Tier",
      "trigger": "特征 | 适用技术",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·7"
    },
    {
      "id": "DES-08",
      "rule": "------",
      "trigger": "------|---------",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·8"
    },
    {
      "id": "DES-09",
      "rule": "Tier 1",
      "trigger": "单文件/CLI | SQLite + 零依赖",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·9"
    },
    {
      "id": "DES-10",
      "rule": "Tier 2",
      "trigger": "轻量Web | FastAPI + 单表",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·10"
    },
    {
      "id": "DES-11",
      "rule": "Tier 3",
      "trigger": "多服务 | PostgreSQL + Redis",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·11"
    },
    {
      "id": "DES-12",
      "rule": "Tier 4+",
      "trigger": "企业级 | K8s + 消息队列",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·12"
    },
    {
      "id": "DES-13",
      "rule": "端口-适配器: 核心逻辑与I/O是否分离？有没有全局可变状态？",
      "trigger": "① 定义 ABC 端口接口 ② 将 I/O 代码移入适配器类 ③ 删除全局变量改为依赖注入",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·13"
    },
    {
      "id": "DES-14",
      "rule": "模块深度: 每个模块是小接口大实现吗？有没有纯透传模块？",
      "trigger": "① 计算\"接口方法数 / 实现行数\"比 ② <0.05 为浅模块→合并相邻模块 ③ 提取大实现到私有方法",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·14"
    },
    {
      "id": "DES-15",
      "rule": "领域边界: 术语是否一致？不同子域有无混淆？",
      "trigger": "① 建立 CONTEXT.md 术语表（见 [[architect-workflow]]）② 不同子域用不同类名/模块名隔离",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·15"
    },
    {
      "id": "DES-16",
      "rule": "规模适配: 当前方案是否过度设计？",
      "trigger": "① 确认 Tier 级别（见上表）② Tier1 用 PostgreSQL → 降级为 SQLite ③ Tier4 用 SQLite → 升级",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·16"
    },
    {
      "id": "DES-17",
      "rule": "依赖方向: 依赖是否指向抽象而非具体实现？",
      "trigger": "① 检查 import 语句 ② 领域层不应 import 适配器 ③ 引入 ABC/Protocol 反转依赖",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·17"
    },
    {
      "id": "DES-18",
      "rule": "单一职责: 每个类/函数只做一件事？",
      "trigger": "① 类 >1500 行 → 按职责拆分为 3-5 个类 ② 函数 >50 行 → 按逻辑段落提取子方法",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·18"
    },
    {
      "id": "DES-19",
      "rule": "单体文件体积: Top-N 文件是否离群？",
      "trigger": "① 按字节/行排序取 Top-N ② 单文件 >800 行或 >30KB 视为 god-file，按职责拆分 ③ 跨项目横评沉淀体积基线",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·19"
    },
    {
      "id": "DES-20",
      "rule": "信号",
      "trigger": "阈值 | 动作",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·20"
    },
    {
      "id": "DES-21",
      "rule": "------",
      "trigger": "------|------",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·21"
    },
    {
      "id": "DES-22",
      "rule": "单体文件",
      "trigger": ">800 行 或 >30KB | 按职责拆分，优先拆组合根/编排/IO",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·22"
    },
    {
      "id": "DES-23",
      "rule": "单个类",
      "trigger": ">1500 行 | 按职责拆为 3-5 个类",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·23"
    },
    {
      "id": "DES-24",
      "rule": "单个函数",
      "trigger": ">50 行 | 提取子方法",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·24"
    },
    {
      "id": "DES-25",
      "rule": "浅模块（接口方法数/实现行数）",
      "trigger": "接口面大于实现（浅模块） | 合并相邻模块",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·25"
    }
  ],
  "output_schema": {
    "required": [
      "id",
      "type",
      "evidence",
      "risk_level",
      "confidence",
      "next_step"
    ],
    "fields": {
      "id": {
        "type": "string",
        "pattern": "^DES-[0-9]{2}$",
        "description": "必须引用 checklist 中的规则 ID"
      },
      "type": {
        "type": "string",
        "enum": [
          "pattern_violation",
          "missing_mechanism",
          "design_flaw",
          "performance_issue",
          "other",
          "unknown"
        ],
        "description": "发现类型"
      },
      "evidence": {
        "type": "string",
        "min_length": 10,
        "description": "行级证据：文件路径 + 行号 + 代码片段"
      },
      "risk_level": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "按 risk-grading-scheme.md 量化口径判定"
      },
      "risk_scheme_ref": {
        "type": "string",
        "description": "引用 risk-grading-scheme.md 触发条件编号"
      },
      "confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "对定级和证据的置信度"
      },
      "next_step": {
        "type": "string",
        "min_length": 10,
        "description": "具体可执行的下一步，含验证命令或人工复核说明"
      },
      "verify_command": {
        "type": "string",
        "description": "可运行的验证命令（GREEN-first）"
      },
      "rollback": {
        "type": "string",
        "description": "失败时的撤退路径"
      }
    }
  },
  "meta": {
    "version": "1.0",
    "updated_at": "2026-09-14",
    "source_skill": "architect-design",
    "scene": "B",
    "note": "本契约仅用于蜂群模式（场景 B）的方案评审。"
  }
}