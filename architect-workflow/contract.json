{
  "dimension": "workflow",
  "checklist": [
    {
      "id": "WOR-01",
      "rule": "领域术语是否在 CONTEXT.md 中有唯一定义？",
      "trigger": "未定义: 创建 CONTEXT.md，列出核心概念+定义+反义词",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·1"
    },
    {
      "id": "WOR-02",
      "rule": "架构决策是否经过了严格追问？",
      "trigger": "未追问: 对每个决策准备2-3个替代方案，写\"为什么选了A不选B\"",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·2"
    },
    {
      "id": "WOR-03",
      "rule": "规格是否写清楚了 Problem/Solution/Out of Scope？",
      "trigger": "缺项: 用 to-spec 模板补全",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·3"
    },
    {
      "id": "WOR-04",
      "rule": "工单是否是垂直切片（每张都能独立验证）？",
      "trigger": "水平切片: 改为按用户故事纵向拆分",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·4"
    },
    {
      "id": "WOR-05",
      "rule": "大型探索任务是否使用 wayfinding 地图？",
      "trigger": "未使用: 写 destinations/known/fog-of-war 三栏",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·5"
    }
  ],
  "output_schema": {
    "required": [
      "id",
      "type",
      "evidence",
      "risk_level",
      "confidence",
      "next_step"
    ],
    "fields": {
      "id": {
        "type": "string",
        "pattern": "^WOR-[0-9]{2}$",
        "description": "必须引用 checklist 中的规则 ID"
      },
      "type": {
        "type": "string",
        "enum": [
          "pattern_violation",
          "missing_mechanism",
          "design_flaw",
          "performance_issue",
          "other",
          "unknown"
        ],
        "description": "发现类型"
      },
      "evidence": {
        "type": "string",
        "min_length": 10,
        "description": "行级证据：文件路径 + 行号 + 代码片段"
      },
      "risk_level": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "按 risk-grading-scheme.md 量化口径判定"
      },
      "risk_scheme_ref": {
        "type": "string",
        "description": "引用 risk-grading-scheme.md 触发条件编号"
      },
      "confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "对定级和证据的置信度"
      },
      "next_step": {
        "type": "string",
        "min_length": 10,
        "description": "具体可执行的下一步，含验证命令或人工复核说明"
      },
      "verify_command": {
        "type": "string",
        "description": "可运行的验证命令（GREEN-first）"
      },
      "rollback": {
        "type": "string",
        "description": "失败时的撤退路径"
      }
    }
  },
  "meta": {
    "version": "1.0",
    "updated_at": "2026-09-14",
    "source_skill": "architect-workflow",
    "scene": "B",
    "note": "本契约仅用于蜂群模式（场景 B）的方案评审。"
  }
}