{
  "dimension": "data",
  "checklist": [
    {
      "id": "DAT-01",
      "rule": "每次 schema 变更都是独立迁移",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·1"
    },
    {
      "id": "DAT-02",
      "rule": "已部署的迁移永远不可修改（只能追加新迁移）",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·2"
    },
    {
      "id": "DAT-03",
      "rule": "DDL 和 DML 分离开",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·3"
    },
    {
      "id": "DAT-04",
      "rule": "迁移必须可逆（有 down/rollback）",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·4"
    },
    {
      "id": "DAT-05",
      "rule": "先用生产量级数据测试",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·5"
    },
    {
      "id": "DAT-06",
      "rule": "用 schema_version 表追踪版本（不要只靠 PRAGMA table_info）",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·6"
    },
    {
      "id": "DAT-07",
      "rule": "多语句写操作包裹在 BEGIN IMMEDIATE ... COMMIT",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·7"
    },
    {
      "id": "DAT-08",
      "rule": "跨表更新使用同一连接",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·8"
    },
    {
      "id": "DAT-09",
      "rule": "避免 SELECT + INSERT 竞态（用 UPSERT）",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·9"
    },
    {
      "id": "DAT-10",
      "rule": "数据导入用单事务批量提交",
      "trigger": "",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·10"
    },
    {
      "id": "DAT-11",
      "rule": "是否每次调用都新建连接？（应该共享）",
      "trigger": "新建连接: 在 __init__ 中创建 self._conn，所有方法复用",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·11"
    },
    {
      "id": "DAT-12",
      "rule": "WAL 模式是否开启？",
      "trigger": "未开启: 执行 PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000;",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·12"
    },
    {
      "id": "DAT-13",
      "rule": "多语句写入是否有事务包裹？",
      "trigger": "无事务: 用 BEGIN IMMEDIATE ... COMMIT 包裹跨语句写入",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·13"
    },
    {
      "id": "DAT-14",
      "rule": "Schema 迁移是否有版本追踪？",
      "trigger": "无追踪: 创建 schema_version 表，每次迁移追加一行",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·14"
    },
    {
      "id": "DAT-15",
      "rule": "是否有跨连接的数据不一致风险？",
      "trigger": "有风险: 确保相关写入使用同一连接+同一事务",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·15"
    },
    {
      "id": "DAT-16",
      "rule": "数据库选型是否匹配数据特征？",
      "trigger": "不匹配: 跑一遍上方的决策树，确认当前选型是否最优",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·16"
    }
  ],
  "output_schema": {
    "required": [
      "id",
      "type",
      "evidence",
      "risk_level",
      "confidence",
      "next_step"
    ],
    "fields": {
      "id": {
        "type": "string",
        "pattern": "^DAT-[0-9]{2}$",
        "description": "必须引用 checklist 中的规则 ID"
      },
      "type": {
        "type": "string",
        "enum": [
          "pattern_violation",
          "missing_mechanism",
          "design_flaw",
          "performance_issue",
          "other",
          "unknown"
        ],
        "description": "发现类型"
      },
      "evidence": {
        "type": "string",
        "min_length": 10,
        "description": "行级证据：文件路径 + 行号 + 代码片段"
      },
      "risk_level": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "按 risk-grading-scheme.md 量化口径判定"
      },
      "risk_scheme_ref": {
        "type": "string",
        "description": "引用 risk-grading-scheme.md 触发条件编号"
      },
      "confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "对定级和证据的置信度"
      },
      "next_step": {
        "type": "string",
        "min_length": 10,
        "description": "具体可执行的下一步，含验证命令或人工复核说明"
      },
      "verify_command": {
        "type": "string",
        "description": "可运行的验证命令（GREEN-first）"
      },
      "rollback": {
        "type": "string",
        "description": "失败时的撤退路径"
      }
    }
  },
  "meta": {
    "version": "1.0",
    "updated_at": "2026-09-14",
    "source_skill": "architect-data",
    "scene": "B",
    "note": "本契约仅用于蜂群模式（场景 B）的方案评审。"
  }
}