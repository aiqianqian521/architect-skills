{
  "dimension": "docs",
  "checklist": [
    {
      "id": "DOC-01",
      "rule": "每个重要技术决策是否有 ADR？",
      "trigger": "没有: 用 ADR 模板补记录（见上方模板）",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·1"
    },
    {
      "id": "DOC-02",
      "rule": "CLAUDE.md 是否有一句话定位 + 运行命令 + 禁止事项？",
      "trigger": "补全: 用\"写给 AI 看的文档\"原则重写",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·2"
    },
    {
      "id": "DOC-03",
      "rule": "文档是否用前导词（\"强制\"、\"禁止\"）而非弱建议？",
      "trigger": "扫描全文，将\"应该\"替换为\"必须\"/\"禁止\"",
      "severity_if_fail": "medium",
      "guide_ref": "核心原则·3"
    },
    {
      "id": "DOC-04",
      "rule": "是否先搜索了已有方案再自己写代码？",
      "trigger": "未搜索: 执行上方 5 步调研流程",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·4"
    },
    {
      "id": "DOC-05",
      "rule": "调研报告是否有引用来源？",
      "trigger": "补: 附上 PyPI/GitHub 链接 + Stars + 最后更新日期",
      "severity_if_fail": "high",
      "guide_ref": "核心原则·5"
    }
  ],
  "output_schema": {
    "required": [
      "id",
      "type",
      "evidence",
      "risk_level",
      "confidence",
      "next_step"
    ],
    "fields": {
      "id": {
        "type": "string",
        "pattern": "^DOC-[0-9]{2}$",
        "description": "必须引用 checklist 中的规则 ID"
      },
      "type": {
        "type": "string",
        "enum": [
          "pattern_violation",
          "missing_mechanism",
          "design_flaw",
          "performance_issue",
          "other",
          "unknown"
        ],
        "description": "发现类型"
      },
      "evidence": {
        "type": "string",
        "min_length": 10,
        "description": "行级证据：文件路径 + 行号 + 代码片段"
      },
      "risk_level": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "按 risk-grading-scheme.md 量化口径判定"
      },
      "risk_scheme_ref": {
        "type": "string",
        "description": "引用 risk-grading-scheme.md 触发条件编号"
      },
      "confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "description": "对定级和证据的置信度"
      },
      "next_step": {
        "type": "string",
        "min_length": 10,
        "description": "具体可执行的下一步，含验证命令或人工复核说明"
      },
      "verify_command": {
        "type": "string",
        "description": "可运行的验证命令（GREEN-first）"
      },
      "rollback": {
        "type": "string",
        "description": "失败时的撤退路径"
      }
    }
  },
  "meta": {
    "version": "1.0",
    "updated_at": "2026-09-14",
    "source_skill": "architect-docs",
    "scene": "B",
    "note": "本契约仅用于蜂群模式（场景 B）的方案评审。"
  }
}