// L2 单项目报告 renderer（五段结构）— 蜂群模式升级版 v2.1
// 第二批改造：B4 方案评审表接入 + B6 矫正四件套（改什么/怎么改/验证/回滚）
// 叠加 P0：--lenient + MISSING_AGENT + 阻断判定
//
// 用法：node render-report.cjs swarm-output.json [--out report.md] [--lenient]
//   swarm-output.json 格式：{ "agents": [...], "project": "...", "proposal": {...} }

const fs = require("fs");
const path = require("path");

const REQUIRED_FINDING_FIELDS = ["id", "type", "evidence", "risk_level", "confidence", "next_step"];
const VALID_DIMENSIONS = new Set([
  "design", "review", "data", "test", "workflow",
  "agent", "git", "docs", "net", "security",
  "ops", "observability", "cost", "compliance", "frontend"
]);
const VALID_RISK_LEVELS = new Set(["critical", "high", "medium", "low"]);
const VALID_CONFIDENCES = new Set(["high", "medium", "low", "unknown"]);
const VALID_TYPES = new Set([
  "masked_bug", "missing_test", "god_file", "hardcoded_secret",
  "config_drift", "missing_validation", "design_flaw", "performance_issue",
  "doc_gap", "compliance_gap", "observability_gap", "other"
]);
const VALID_AGENT_STATUS = new Set(["completed", "partial", "failed", "timeout"]);

// ---- B4：方案完整性校验 ----
const PROPOSAL_REQUIRED_FIELDS = ["target", "gap", "migration", "compat", "acceptance", "owner"];

function validateProposal(proposal) {
  if (!proposal) return { complete: false, missing: PROPOSAL_REQUIRED_FIELDS, level: "critical" };
  const missing = [];
  for (const f of PROPOSAL_REQUIRED_FIELDS) {
    if (!proposal[f] || (typeof proposal[f] === "string" && proposal[f].trim() === "")) {
      missing.push(f);
    }
  }
  // acceptance 必须含可运行命令
  if (proposal.acceptance && Array.isArray(proposal.acceptance)) {
    const hasCmd = proposal.acceptance.some(a => a.cmd && a.cmd.trim() !== "");
    if (!hasCmd) missing.push("acceptance.cmd");
  } else if (proposal.acceptance && typeof proposal.acceptance === "string") {
    // 字符串形式也允许，但最好转数组
  } else {
    missing.push("acceptance");
  }

  const complete = missing.length === 0;
  // 严重度：缺 >2 项为 critical，否则 high
  const level = missing.length > 2 ? "critical" : (missing.length > 0 ? "high" : null);
  return { complete, missing, level };
}

// ---- 校验层 ----
function validateAgentOutput(agentOut, idx) {
  const errors = [];
  const prefix = `agents[${idx}]`;
  if (!agentOut.agent) errors.push(`${prefix}.agent: missing`);
  if (!agentOut.dimension) errors.push(`${prefix}.dimension: missing`);
  else if (!VALID_DIMENSIONS.has(agentOut.dimension)) errors.push(`${prefix}.dimension: invalid "${agentOut.dimension}"`);
  if (agentOut.status && !VALID_AGENT_STATUS.has(agentOut.status)) errors.push(`${prefix}.status: invalid "${agentOut.status}"`);
  if (!Array.isArray(agentOut.findings)) { errors.push(`${prefix}.findings: must be array`); return errors; }

  for (let i = 0; i < agentOut.findings.length; i++) {
    const f = agentOut.findings[i];
    const fp = `${prefix}.findings[${i}]`;
    for (const field of REQUIRED_FINDING_FIELDS) {
      if (f[field] === undefined || f[field] === null || f[field] === "") errors.push(`${fp}.${field}: missing or empty`);
    }
    if (f.risk_level && !VALID_RISK_LEVELS.has(f.risk_level)) errors.push(`${fp}.risk_level: invalid "${f.risk_level}"`);
    if (f.confidence && !VALID_CONFIDENCES.has(f.confidence)) errors.push(`${fp}.confidence: invalid "${f.confidence}"`);
    if (f.type && !VALID_TYPES.has(f.type)) errors.push(`${fp}.type: invalid "${f.type}"`);
  }
  return errors;
}

// ---- MISSING_AGENT 检测 ----
function detectMissingAgents(agents) {
  const missing = [];
  for (const agent of agents) {
    if (agent.status === "timeout" || agent.status === "failed") {
      missing.push({ agent: agent.agent, dimension: agent.dimension, status: agent.status, reason: agent.coverage?.reason || agent.meta?.notes || "agent 未返回有效输出" });
    }
  }
  return missing;
}

// ---- 聚合层 ----
function aggregateAgents(agents) {
  const allFindings = []; const evidenceMap = new Map(); const conflicts = []; const unknowns = []; const coverageMap = {};
  for (const agent of agents) {
    if (agent.coverage) coverageMap[agent.dimension] = agent.coverage;
    if (agent.status === "timeout" || agent.status === "failed") continue;
    for (const f of agent.findings) {
      const enriched = { ...f, _agent: agent.agent, _dimension: agent.dimension };
      if (!f.confidence) { enriched.confidence = "unknown"; enriched._autoFlagged = true; }
      if (enriched.confidence === "unknown") { unknowns.push(enriched); continue; }
      allFindings.push(enriched);
      const key = f.file_line || f.evidence;
      if (key) {
        if (!evidenceMap.has(key)) evidenceMap.set(key, []);
        const existing = evidenceMap.get(key);
        for (const prev of existing) {
          const levelDiff = Math.abs(levelToNum(prev.risk_level) - levelToNum(f.risk_level));
          const confDiff = Math.abs(confToNum(prev.confidence) - confToNum(enriched.confidence));
          if (levelDiff >= 2 || confDiff >= 2) {
            conflicts.push({ conflict_id: `C-EVIDENCE-${conflicts.length + 1}`, type: "C-EVIDENCE", key, agent_a: prev._agent, agent_b: enriched._agent, finding_a: prev, finding_b: enriched });
          }
        }
        existing.push(enriched);
      }
    }
  }
  return { allFindings, conflicts, unknowns, coverageMap };
}
function levelToNum(lv) { return { critical: 4, high: 3, medium: 2, low: 1 }[lv] || 0; }
function confToNum(cf) { return { high: 3, medium: 2, low: 1, unknown: 0 }[cf] || 0; }

// ---- 通过判定（P1: assessment/review 模式感知）----
function computeVerdict(allFindings, missingAgents, unknowns, proposalCheck, mode) {
  const isReview = mode === "review";
  const hasCritical = allFindings.some(f => f.risk_level === "critical");
  const hasMissingAgent = missingAgents.length > 0;

  // P8: 阻塞/门禁只在 review 模式且 proposal 不完整时触发；
  // assessment 模式（评估现有项目）proposal 非必填，不判不通过。
  if (isReview && !proposalCheck.complete) {
    return { pass: false, label: "PROPOSAL_INCOMPLETE", blockedOn: "proposal",
      reason: `方案不完整，缺失字段：${proposalCheck.missing.join(", ")}。请先补全方案再进入通过判定。` };
  }
  if (hasMissingAgent) {
    return { pass: false, label: "BLOCKED", blockedOn: "missing_agent", 
      reason: `存在 ${missingAgents.length} 个 agent 失联/失败（${missingAgents.map(m => m.dimension).join(", ")}），评估不可判通过。` };
  }
  if (hasCritical) {
    return { pass: false, label: "BLOCKED", blockedOn: "critical",
      reason: `存在 ${allFindings.filter(f => f.risk_level === "critical").length} 个 critical 发现，方案阻塞。` };
  }
  if (unknowns.length > 0) {
    return { pass: false, label: "NEED_REVIEW", blockedOn: "unknown",
      reason: `存在 ${unknowns.length} 个 unknown 置信度发现，需人工复核后方可通过。` };
  }
  return { pass: true, label: "PASSED", blockedOn: null, reason: "无 critical 发现，无 agent 失联，无 unknown 项。" };
}

// ---- B6：矫正四件套完整性检查 ----
function checkRemediationCompleteness(finding) {
  const missing = [];
  // 改什么：evidence 已含
  // 怎么改：next_step
  if (!finding.next_step) missing.push("next_step");
  // 验证：verify_command
  if (!finding.verify_command) missing.push("verify_command");
  // 回滚：rollback（第二批新增字段）
  if (!finding.rollback) missing.push("rollback");
  return { complete: missing.length === 0, missing };
}


// ---- P4: 从 agent meta 推导最小架构地图 ----
function deriveArchMap(agents) {
  const dirSet = new Map();
  for (const a of agents) {
    const meta = a.meta || {};
    const files = meta.files_read || [];
    for (const f of files) {
      const norm = String(f).replace(/\\/g, "/");
      const dir = norm.includes("/") ? norm.substring(0, norm.lastIndexOf("/")) : "./";
      if (dir && !dirSet.has(dir)) dirSet.set(dir, { dir, role: "（待补：据 Intake 建图）", evidence: f, _agent: a.agent });
    }
    for (const fd of (a.findings || [])) {
      if (fd.file_line && !dirSet.has(fd.file_line)) {
        const norm = String(fd.file_line).replace(/\\/g, "/");
        const dir = norm.includes("/") ? norm.substring(0, norm.lastIndexOf("/")) : "./";
        if (!dirSet.has(dir)) dirSet.set(dir, { dir, role: "（待补：据 Intake 建图）", evidence: fd.file_line, _agent: a.agent });
      }
    }
  }
  return Array.from(dirSet.values()).slice(0, 15);
}

// ---- P3/P7: N/A 与未评审归一 ----
function coverageStatus(dim, cov, findingCount, missingMap, naSet) {
  if (naSet.has(dim) || (cov && (cov.status === "N/A" || cov.status === "not-applicable"))) return "N/A";
  if (missingMap.has(dim)) return "missing";
  if (findingCount > 0) return cov && cov.status ? cov.status : "covered";
  return "未评审";
}

// ---- 渲染层 ----
function renderL2Report(input, options = {}) {
  const lenient = options.lenient || false;
  const agents = input.agents || [];
  // P1: 模式感知：显式 mode 优先；否则有 proposal 视为 review，无 proposal 视为 assessment。
  const mode = options.mode || (input.proposal ? "review" : "assessment");
  const isReview = mode === "review";

  // B4：方案完整性校验（review 模式下才作为门禁）
  const proposalCheck = validateProposal(input.proposal);

  // 校验 agent 输出
  const allErrors = [];
  for (let i = 0; i < agents.length; i++) allErrors.push(...validateAgentOutput(agents[i], i, lenient));
  if (allErrors.length > 0) {
    const msg = "以下 agent 输出不符合 agent-output-schema.json：\n" + allErrors.map(e => "  - " + e).join("\n");
    if (lenient) { input._rendererWarnings = allErrors; }
    else { throw new Error(msg); }
  }

  const missingAgents = detectMissingAgents(agents);
  const { allFindings, conflicts, unknowns, coverageMap } = aggregateAgents(agents);

  const counts = { critical: 0, high: 0, medium: 0, low: 0 };
  const byLevel = { critical: [], high: [], medium: [], low: [] };
  const byDimension = {};
  for (const f of allFindings) {
    const lv = f.risk_level;
    if (counts[lv] !== undefined) { counts[lv]++; if (!byLevel[lv].includes(f._dimension)) byLevel[lv].push(f._dimension); }
    if (!byDimension[f._dimension]) byDimension[f._dimension] = [];
    byDimension[f._dimension].push(f);
  }

  const verdict = computeVerdict(allFindings, missingAgents, unknowns, proposalCheck, mode);
  const project = input.project || "?";
  const evaluatedAt = input.evaluatedAt || new Date().toISOString();
  let out = `# 架构评估报告：${project}（蜂群模式，${evaluatedAt}）\n\n`;

  // 门禁横幅（P8: 不与正文"已阻塞"语义冲突）
  const verdictIcon = verdict.pass ? "✅" : "❌";
  out += `## 门禁判定：${verdictIcon} ${verdict.label}（模式：${mode}）\n\n`;
  out += `> ${verdict.reason}\n\n`;
  if (mode === "assessment") {
    out += `> （评估现有项目模式：proposal 非必填，本报告已按全维评审输出；如需"评审改造方案"请用 review 模式并提供 proposal。）\n\n`;
  }

  // B4：方案完整性区块（仅 review 模式渲染为门禁；assessment 模式若附带 proposal 缺失也仅提示）
  if (isReview && !proposalCheck.complete) {
    out += "### 📋 方案完整性检查\n\n";
    out += `| 检查项 | 状态 |\n|---|---|\n`;
    for (const f of PROPOSAL_REQUIRED_FIELDS) {
      const has = input.proposal && input.proposal[f] && (typeof input.proposal[f] !== "string" || input.proposal[f].trim() !== "");
      out += `| ${f} | ${has ? "✅" : "❌ 缺失"} |\n`;
    }
    if (input.proposal && Array.isArray(input.proposal.acceptance)) {
      const hasCmd = input.proposal.acceptance.some(a => a.cmd && a.cmd.trim() !== "");
      out += `| acceptance.cmd | ${hasCmd ? "✅" : "❌ 无可运行命令"} |\n`;
    }
    out += `\n> **方案不完整，已进入通过门槛阻塞。请先补全上述字段后重跑获得 PASSED 判定；本报告仍附全维评审结果供参考。**\n\n`;
  } else if (input.proposal) {
    out += "### 📋 方案信息\n\n";
    out += `| 字段 | 内容 |\n|---|---|\n`;
    out += `| target | ${input.proposal.target || "—"} |\n`;
    out += `| gap | ${input.proposal.gap || "—"} |\n`;
    out += `| scope | ${input.proposal.scope || "—"} |\n`;
    out += `| migration | ${input.proposal.migration || "—"} |\n`;
    out += `| compat | ${input.proposal.compat || "—"} |\n`;
    if (Array.isArray(input.proposal.acceptance)) {
      out += `| acceptance | ${input.proposal.acceptance.map(a => `\`${a.cmd}\` → ${a.pass_when}`).join("；")} |\n`;
    } else {
      out += `| acceptance | ${input.proposal.acceptance || "—"} |\n`;
    }
    out += `| owner | ${input.proposal.owner || "—"} |\n`;
    if (input.proposal.due) out += `| due | ${input.proposal.due} |\n`;
    out += "\n";
  }

  if (lenient && input._rendererWarnings) {
    out += "### ⚠️ Lenient 模式警告（未阻断）\n\n";
    for (const w of input._rendererWarnings) out += `- ${w}\n`;
    out += "\n";
  }

  if (missingAgents.length > 0) {
    out += "### 🚨 MISSING_AGENT 告警\n\n";
    out += "| 维度 | 代理 | 状态 | 原因 |\n|---|---|---|---|\n";
    for (const m of missingAgents) out += `| ${m.dimension} | ${m.agent} | ${m.status} | ${m.reason} |\n`;
    out += "\n> **该方案因 agent 失联不可判通过。请重新运行缺失维度评估。**\n\n";
  }

  // ① 项目架构地图
  out += "## ① 项目架构地图\n\n";
  const archMap = (input.archMap && input.archMap.length) ? input.archMap : deriveArchMap(agents);
  if (archMap.length) {
    out += "| 目录/入口 | 职责一句话 | 关键文件(行级) |\n|----------|-----------|--------------|\n";
    for (const a of archMap) out += `| ${a.dir} | ${a.role || ""} | ${a.evidence || ""} |\n`;
  } else { out += "（由评估者据 Intake 建图填写；renderer 强制本节存在。）\n"; }
  out += "\n";

  // ② 维度覆盖矩阵
  out += "## ② 维度覆盖矩阵\n\n";
  out += "| 维度 | 状态 | 证据数 | 最高风险 | 未知项 |\n|---|---|---|---|---|\n";
  const naDims = new Set(agents.filter(a => a.coverage && (a.coverage.status === "N/A" || a.coverage.status === "not-applicable")).map(a => a.dimension));
  const missingMap = new Set(missingAgents.filter(m => m.dimension).map(m => m.dimension));
  for (const dim of VALID_DIMENSIONS) {
    const cov = coverageMap[dim];
    const findings = byDimension[dim] || [];
    const status = coverageStatus(dim, cov, findings.length, missingMap, naDims);
    const maxRisk = findings.length ? findings.reduce((a, b) => levelToNum(a.risk_level) > levelToNum(b.risk_level) ? a : b).risk_level : "—";
    const unknownCount = unknowns.filter(u => u._dimension === dim).length;
    const missingFlag = missingAgents.some(m => m.dimension === dim) ? " ⚠️失联" : "";
    const naNote = (status === "N/A") ? "（复检条件见 risk-grading-scheme §一）" : "";
    out += `| ${dim} | ${status}${missingFlag}${naNote} | ${findings.length} | ${maxRisk} | ${unknownCount > 0 ? unknownCount : "—"} |\n`;
  }
  out += `\n> 状态口径：covered/partial=有评审产出，missing=代理遗漏/失联，N/A=维度不适用（带复检条件），未评审=本轮无代理评估。\n\n`;

  // ③ 各 skill 详细分析
  out += "## ③ 各 skill 详细分析\n\n";
  let hasContent = false;
  for (const dim of VALID_DIMENSIONS) {
    const findings = byDimension[dim];
    if (!findings || findings.length === 0) continue;
    hasContent = true;
    out += `### ${dim}\n`;
    for (const f of findings) {
      out += `- **${f.id}**（${f.risk_level} · ${f.confidence}${f._autoFlagged ? " · auto-flagged" : ""}）\n`;
      out += `  - 类型: ${f.type}\n`;
      out += `  - 证据: ${f.evidence}${f.file_line ? `（${f.file_line}）` : ""}\n`;
      if (f.risk_scheme_ref) out += `  - 触发条件: ${f.risk_scheme_ref}\n`;
      out += `  - 下一步: ${f.next_step}\n`;
      if (f.verify_command) out += `  - 验证命令: \`${f.verify_command}\`\n`;
      if (f.response_time) out += `  - 响应时间: ${f.response_time}\n`;
      // B6：回滚字段
      if (f.rollback) out += `  - 回滚: ${f.rollback}\n`;
      else out += `  - 回滚: ⚠️ 未提供（矫正四件套缺失）\n`;
      if (f.related_dimensions && f.related_dimensions.length) out += `  - 关联维度: ${f.related_dimensions.join(", ")}\n`;
      out += "\n";
    }
  }
  if (!hasContent) out += "（每个命中的架构师 skill 独立小节。renderer 强制本节存在。）\n\n";

  // ④ 问题点汇总统计
  out += "## ④ 问题点汇总统计（cspm 风格）\n\n";
  out += "| 风险级 | 计数 | 涉及维度 |\n|--------|------|---------|\n";
  out += `| critical | ${counts.critical} | ${byLevel.critical.join("，") || "—"} |\n`;
  out += `| high | ${counts.high} | ${byLevel.high.join("，") || "—"} |\n`;
  out += `| medium | ${counts.medium} | — |\n`;
  out += `| low | ${counts.low} | — |\n\n`;
  out += `> 风险级由 renderer 从结构化输入计算，非 LLM 主观；定级口径见 reference/risk-grading-scheme.md。\n\n`;

  if (conflicts.length > 0) {
    out += "### ⚠️ 跨维度冲突检测\n\n";
    out += "| 冲突ID | 类型 | 证据 | 代理A | 代理B | 仲裁 |\n|--------|------|------|-------|-------|------|\n";
    for (const c of conflicts) out += `| ${c.conflict_id} | ${c.type} | ${c.key} | ${c.agent_a}: ${c.finding_a.risk_level} | ${c.agent_b}: ${c.finding_b.risk_level} | 待复核 |\n`;
    out += "\n";
  }

  // ⑤ 改进方案 —— Critical/High 阻塞项详述（B6：矫正四件套强制化）
  out += "## ⑤ 改进方案 —— Critical/High 阻塞项详述\n\n";
  const blockers = allFindings.filter(f => f.risk_level === "critical" || f.risk_level === "high");
  if (blockers.length > 0) {
    for (const b of blockers) {
      const rem = checkRemediationCompleteness(b);
      out += `### ${b.id}（${b.risk_level} · ${b._dimension}）${rem.complete ? "" : " · ⚠️矫正项不完整"}\n`;
      out += `- 现象: ${b.type}\n`;
      out += `- 证据: ${b.evidence}${b.file_line ? `（${b.file_line}）` : ""}\n`;
      out += `- 根因: ${b._agent} 评估发现\n`;
      // B6：矫正四件套
      out += `- 改什么: ${b.evidence}\n`;
      out += `- 怎么改: ${b.next_step || "⚠️ 缺失"}\n`;
      out += `- 验证: ${b.verify_command ? `\`${b.verify_command}\`` : "⚠️ 缺失"}\n`;
      out += `- 回滚: ${b.rollback || "⚠️ 缺失"}\n`;
      if (!rem.complete) out += `- ⚠️ 矫正四件套缺失: ${rem.missing.join(", ")} — 该项不可 closed\n`;
      out += `- 影响: 见风险分级方案 ${b.risk_scheme_ref || "§一"}\n`;
      if (b.response_time) out += `- 响应时间: ${b.response_time}\n`;
      out += "\n";
    }
  } else {
    out += "（无 critical/high 阻塞项。renderer 强制本节存在。）\n\n";
  }

  // ⑥ 待复核项
  if (unknowns.length > 0 || conflicts.length > 0 || missingAgents.length > 0) {
    out += "## ⑥ 待复核项\n\n";
    out += "> 以下项因置信度不足、agent 间冲突或 agent 失联，需人工确认后纳入正式报告。\n\n";
    if (missingAgents.length > 0) {
      out += "### Agent 失联/失败\n\n";
      for (const m of missingAgents) { out += `- **${m.dimension}**（${m.agent} · ${m.status}）\n  - 原因: ${m.reason}\n  - 建议: 重新运行 ${m.dimension} agent 或人工补评\n\n`; }
    }
    if (unknowns.length > 0) {
      out += "### 置信度未知\n\n";
      for (const u of unknowns) { out += `- **${u.id}**（${u._dimension} · ${u._agent}）\n  - 原因: ${u._autoFlagged ? "confidence 字段缺失，renderer 自动标记" : "agent 显式标记 unknown"}\n  - 证据: ${u.evidence || "无"}\n  - 建议: 人工复核或重新运行 ${u._dimension} agent\n\n`; }
    }
    if (conflicts.length > 0) {
      out += "### 代理间冲突\n\n";
      for (const c of conflicts) { out += `- **${c.conflict_id}**（${c.type}）\n  - 证据: ${c.key}\n  - ${c.agent_a}: ${c.finding_a.risk_level}（${c.finding_a.confidence}）\n  - ${c.agent_b}: ${c.finding_b.risk_level}（${c.finding_b.confidence}）\n  - 建议: 按 swarm-orchestrator.md §4 仲裁规则处理\n\n`; }
    }
  }

  // narrative（P2: 缺失不再静默，输出完整性警告）
  const n = input.narratives || {};
  const missingNarrative = [];
  if (!n.summary) missingNarrative.push("summary(结论叙述)");
  if (!n.keyFindings) missingNarrative.push("keyFindings(关键发现)");
  if (!n.hardening) missingNarrative.push("hardening(加固建议)");
  if (!n.nextSteps) missingNarrative.push("nextSteps(下一步)");
  out += "## 结论叙述\n\n" + (n.summary || "") + "\n\n";
  out += "## 关键发现\n\n" + (n.keyFindings || "") + "\n\n";
  out += "## 加固建议\n\n" + (n.hardening || "") + "\n\n";
  out += "## 下一步\n\n" + (n.nextSteps || "") + "\n";
  if (missingNarrative.length > 0) {
    out += `\n## ⚠️ 报告完整性警告（NARRATIVE_MISSING）\n\n`;
    out += `> 以下叙述段为空：${missingNarrative.join("、")}。建议评估者补齐后再作为正式报告存档；若为机器聚合产物请注明。\n`;
  }

  return out;
}

module.exports = { renderL2Report, validateAgentOutput, aggregateAgents, detectMissingAgents, computeVerdict, validateProposal, checkRemediationCompleteness };

if (require.main === module) {
  const args = process.argv.slice(2);
  const arg = args[0];
  const lenient = args.includes("--lenient");
  if (!arg || arg.startsWith("--")) {
    console.error("usage: node render-report.cjs input.json [--out report.md] [--lenient]");
    console.error("  input.json: { agents: [...], project: '...', proposal: {...}, archMap: [...], narratives: {...} }");
    process.exit(2);
  }
  const input = JSON.parse(fs.readFileSync(arg, "utf8"));
  try {
    const md = renderL2Report(input, { lenient });
    const outIdx = args.indexOf("--out");
    if (outIdx !== -1 && args[outIdx + 1]) {
      fs.mkdirSync(path.dirname(args[outIdx + 1]), { recursive: true });
      fs.writeFileSync(args[outIdx + 1], md, "utf8");
      console.log("rendered -> " + args[outIdx + 1]);
    } else { process.stdout.write(md); }
  } catch (err) {
    console.error("RENDERER_REJECT:", err.message);
    process.exit(3);
  }
}
